# Local development. Never commit real secrets in this file.
DEV_MODE=true
TESTING=false
ENFORCE_PRODUCTION_CONFIG=false
APP_BASE_URL=http://127.0.0.1:5000
PUBLIC_BASE_URL=http://127.0.0.1:5000
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

DATABASE_URL=sqlite:///./data/aitutor.db
PGVECTOR_DATABASE_URL=sqlite:///./data/aitutor-vectors.db
REDIS_URL=

# Local/free provider defaults. Cloud Run overrides these in deploy/cloud-run.env.yaml.example.
LLM_PROVIDER=ollama
QUICK_REVIEW_PROVIDER=ollama
DETAIL_REVIEW_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_QUICK_REVIEW_MODEL=qwen2.5:1.5b
OLLAMA_DETAIL_REVIEW_MODEL=qwen2.5:1.5b

# RAG-first settings.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RAG_MAX_QUERY_RESULTS=50
RAG_MAX_RETRIES=2
RAG_RETRY_DELAY=0.25
HOMEWORK_SUBJECT_WORKERS=4

# Latency and prompt budgets.
MAX_AI_CONCURRENCY=8
AI_QUEUE_TIMEOUT_SECONDS=4
AI_REQUEST_TIMEOUT_SECONDS=90
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1
LLM_RETRY_DELAY=0.5
QUICK_REVIEW_MAX_TOKENS=1000
DETAIL_REVIEW_MAX_TOKENS=3000
PRACTICE_MAX_TOKENS=3000
REVIEW_HOMEWORK_MAX_CHARS=8000
REVIEW_ANSWERS_MAX_CHARS=4000
REVIEW_FEEDBACK_MAX_CHARS=2000

# Development-only placeholders.
SESSION_OWNER_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAILS=parent-admin@example.com
DATA_CONTROLLER_NAME=Local development operator
BUSINESS_CONTACT_EMAIL=contact@homeworkmagic.co.uk
PRIVACY_CONTACT_EMAIL=privacy@homeworkmagic.co.uk
PRIVACY_POSTAL_ADDRESS=Replace before production
BUSINESS_SUPPORT_PHONE=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_VAT_STATUS=
STORE_RAW_LEARNER_CONTENT=false
STORE_RAW_AI_CONTENT=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

STRIPE_BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_TRIAL_5DAY=
STRIPE_PRICE_HOMEWORK_MONTHLY=
STRIPE_PRICE_ELEVENPLUS_MONTHLY=

# Google Cloud / Vertex values used by the production template.
GOOGLE_CLOUD_PROJECT=aitutor-502921
GOOGLE_CLOUD_LOCATION=global
INSTANCE_CONNECTION_NAME=aitutor-502921:europe-west2:aitutor-prod-pg
DEEPSEEK_API_KEY=
