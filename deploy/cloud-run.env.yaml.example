# Copy to deploy/cloud-run.env.yaml and replace every REPLACE_ value.
# Keep passwords, API keys, Stripe secrets and invite codes in Secret Manager,
# not in this file.

DEV_MODE: "false"
ENFORCE_PRODUCTION_CONFIG: "true"
APP_BASE_URL: "https://homeworkmagic.co.uk"
CORS_ORIGINS: "https://homeworkmagic.co.uk,https://www.homeworkmagic.co.uk"
TRUST_PROXY_HEADERS: "true"
COOKIE_SECURE: "true"

ADMIN_EMAILS: "REPLACE_WITH_ADMIN_EMAIL"
DATA_CONTROLLER_NAME: "REPLACE_WITH_LEGAL_OPERATOR_NAME"
PRIVACY_CONTACT_EMAIL: "privacy@homeworkmagic.co.uk"
PRIVACY_POSTAL_ADDRESS: "REPLACE_WITH_BUSINESS_OR_SERVICE_ADDRESS"
BUSINESS_CONTACT_EMAIL: "contact@homeworkmagic.co.uk"

GOOGLE_CLOUD_PROJECT: "aitutor-502921"
GOOGLE_CLOUD_LOCATION: "europe-west2"
QUICK_REVIEW_PROVIDER: "deepseek"
QUICK_REVIEW_MODEL: "deepseek-v4-flash"
DETAIL_REVIEW_PROVIDER: "vertex_ai"
DETAIL_REVIEW_MODEL: "gemini-2.5-flash"

SMTP_HOST: "smtp-relay.brevo.com"
SMTP_PORT: "587"
SMTP_USERNAME: "REPLACE_WITH_BREVO_SMTP_LOGIN"
SMTP_FROM: "contact@homeworkmagic.co.uk"
SMTP_FROM_NAME: "Homework Magic"
SMTP_USE_TLS: "true"

STRIPE_BILLING_ENABLED: "true"
STRIPE_EXPECTED_LIVEMODE: "true"
STRIPE_PRICE_TRIAL_5DAY: "REPLACE_STRIPE_PRICE_TRIAL_5DAY"
STRIPE_PRICE_HOMEWORK_MONTHLY: "REPLACE_STRIPE_PRICE_HOMEWORK_MONTHLY"
STRIPE_PRICE_ELEVENPLUS_MONTHLY: "REPLACE_STRIPE_PRICE_ELEVENPLUS_MONTHLY"
STRIPE_PRICING_TABLE_ID: "prctbl_1TvlP9A7C4P8kXJMSS8t4VRT"
STRIPE_PUBLISHABLE_KEY: "pk_live_fYeIDSqsqYC6MDKau5eFsI0U"

# Aggregate-only, first-party counters. These tables do not contain account,
# learner, email, cookie, IP, answer, score, school or free-text fields.
MARKETING_METRICS_ENABLED: "true"
VOICE_METRICS_ENABLED: "true"

# Keep disabled until a strong BETA_ACCESS_CODE is stored in Secret Manager
# and bound to the Cloud Run service. The application hard-caps the cohort at
# 15 family accounts even if a larger value is supplied.
BETA_ACCESS_ENABLED: "false"
BETA_ACCESS_MAX_FAMILIES: "15"
BETA_ACCESS_DURATION_DAYS: "14"

STORE_RAW_LEARNER_CONTENT: "false"
STORE_RAW_AI_CONTENT: "false"
MESSAGE_RETENTION_DAYS: "180"
REWARD_DELIVERY_ADDRESS_RETENTION_DAYS: "30"

MAX_AI_CONCURRENCY: "20"
MAX_PROVIDER_CONCURRENCY: "24"
MAX_UPLOAD_CONCURRENCY: "12"
MAX_BLOCKING_WORKERS: "32"
WEB_CONCURRENCY: "1"
AI_QUEUE_TIMEOUT_SECONDS: "10"
AI_REQUEST_TIMEOUT_SECONDS: "90"
MAX_REQUEST_BYTES: "18874368"
DB_POOL_SIZE: "3"
DB_MAX_OVERFLOW: "2"
DB_POOL_TIMEOUT_SECONDS: "10"
