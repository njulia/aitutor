# Copy to deploy/cloud-run.env.yaml and replace the REPLACE_ values.
# Secrets remain in Secret Manager and are attached by deploy_gcp.sh.

DEV_MODE: "false"
TESTING: "false"
ENFORCE_PRODUCTION_CONFIG: "true"
APP_BASE_URL: "https://homeworkmagic.co.uk"
CORS_ORIGINS: "https://homeworkmagic.co.uk,https://www.homeworkmagic.co.uk"
CANONICAL_REDIRECT_HOSTS: "www.homeworkmagic.co.uk"
COOKIE_SECURE: "true"
TRUST_PROXY_HEADERS: "true"

GOOGLE_CLOUD_PROJECT: "aitutor-502921"
GOOGLE_CLOUD_LOCATION: "europe-west2"
QUICK_REVIEW_PROVIDER: "deepseek"
QUICK_REVIEW_MODEL: "deepseek-v4-flash"
DETAIL_REVIEW_PROVIDER: "vertex_ai"
DETAIL_REVIEW_MODEL: "gemini-2.5-flash"

# One worker shares provider clients and database pools. Cloud Run supplies
# process-level scale; bounded I/O threads handle requests inside each instance.
WEB_CONCURRENCY: "1"
MAX_AI_CONCURRENCY: "20"
MAX_UPLOAD_CONCURRENCY: "12"
MAX_BLOCKING_WORKERS: "32"
AI_QUEUE_TIMEOUT_SECONDS: "15"
AI_REQUEST_TIMEOUT_SECONDS: "105"
LLM_CONNECT_TIMEOUT_SECONDS: "5"
LLM_TIMEOUT_SECONDS: "50"
LLM_MAX_RETRIES: "1"
LLM_RETRY_DELAY: "0.5"
LLM_HTTP_POOL_CONNECTIONS: "8"
LLM_HTTP_POOL_MAXSIZE: "24"
MAX_PROVIDER_CONCURRENCY: "24"
PROVIDER_QUEUE_TIMEOUT_SECONDS: "15"

# All application stores share one SQLAlchemy engine per URL.
DB_POOL_SIZE: "3"
DB_MAX_OVERFLOW: "2"
DB_POOL_TIMEOUT_SECONDS: "10"
DB_POOL_RECYCLE_SECONDS: "1800"
SESSION_TOUCH_INTERVAL_SECONDS: "300"

MAX_REQUEST_BYTES: "25165824"
MAX_EXTRACTED_TEXT_CHARS: "12000"
MAX_PDF_PAGES: "20"
STORE_RAW_LEARNER_CONTENT: "false"
STORE_RAW_AI_CONTENT: "false"

DATA_CONTROLLER_NAME: "REPLACE_LEGAL_OPERATOR_NAME"
PRIVACY_CONTACT_EMAIL: "REPLACE_PRIVACY_EMAIL"
PRIVACY_POSTAL_ADDRESS: "REPLACE_PRIVACY_POSTAL_ADDRESS"
BUSINESS_CONTACT_EMAIL: "REPLACE_SUPPORT_EMAIL"
ADMIN_EMAILS: "REPLACE_ADMIN_EMAIL"

# These are live Stripe Price IDs, not Product IDs and not Pricing Table IDs.
# The Stripe secret key and webhook signing secret stay in Secret Manager.
STRIPE_BILLING_ENABLED: "true"
STRIPE_EXPECTED_LIVEMODE: "true"
STRIPE_PRICE_TRIAL_5DAY: "REPLACE_STRIPE_PRICE_TRIAL_5DAY"
STRIPE_PRICE_HOMEWORK_MONTHLY: "REPLACE_STRIPE_PRICE_HOMEWORK_MONTHLY"
STRIPE_PRICE_ELEVENPLUS_MONTHLY: "REPLACE_STRIPE_PRICE_ELEVENPLUS_MONTHLY"

SMTP_HOST: "smtp-relay.brevo.com"
SMTP_PORT: "587"
SMTP_USERNAME: "REPLACE_SMTP_USERNAME"
SMTP_FROM: "Homework Magic <contact@homeworkmagic.co.uk>"
